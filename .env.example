# =====================================================================
# Vicinity — Environment Configuration (.env.example)
#
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# =====================================================================

# ── Snowflake ────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA_NAME=RAW
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_ROLE=your_role

# ── LLM Providers ────────────────────────────────────────────────────
# DeepSeek is the primary (cheap), OpenAI is the fallback.
# Anthropic key reserved for Claude Desktop MCP integration.
ANTHROPIC_API_KEY=sk-ant-api-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ── AWS S3 (raw API response backup) ────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA-your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# ── Slack (Airflow DAG failure alerts) ──────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Pinecone (narrative vector store) ───────────────────────────────
PINECONE_API_KEY=pcsk-your-pinecone-key
PINECONE_INDEX=vicinity-dev
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Redis (cache) ────────────────────────────────────────────────────
# Leave empty to disable caching (degrades to no-op, slower but functional).
REDIS_URL=redis://localhost:6379/1

# ── Google Maps (directions, geocoding, distance matrix) ────────────
# Restrict this key to the Maps APIs you use + IP allowlist.
GOOGLE_MAPS_API=your-google-maps-api-key

# ── JWT Auth ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-long-random-string-at-least-64-chars
JWT_EXPIRY_HOURS=72